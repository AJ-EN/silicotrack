# SilicoTrack — local development
#
# Postgres everywhere: the same engine locally and in deployment, so a query
# that works on your machine works on the deployed app.
#
# For a local database, run:
#
#     npx prisma dev --detach
#
# It prints a connection string. Paste it below, then:
#
#     npx prisma migrate dev
#     npm run seed
#
# For deployment, use a hosted Postgres connection string instead. Nothing in
# the application changes — only this URL.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/postgres?sslmode=disable"
